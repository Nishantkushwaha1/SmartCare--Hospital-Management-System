# ---- Server ----
NODE_ENV=development
PORT=5000
# Origins allowed to call the API from a browser (comma separated). Not needed when the
# server also serves the built frontend (same origin).
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the server (nginx, Render, Railway...). 0 = none.
TRUST_PROXY=0

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/smartcare
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartcare
MONGODB_URI=mongodb://127.0.0.1:27017/smartcare

# ---- Staff authentication ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# First staff account, created automatically on first start if no staff exists (password 8+ chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Hospital Admin

# ---- Payment mode ----
# demo     = practice payment window, no Razorpay account needed, no real money (ignored in production)
# razorpay = real Razorpay checkout (needs the keys below). Leave empty for this.
PAYMENT_MODE=demo

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
# Use TEST keys (rzp_test_...) while developing: no real money moves.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Secret you type when creating the webhook in the Razorpay dashboard
# (Settings > Webhooks > URL: https://<your-domain>/api/payments/webhook,
#  events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ---- Queue behaviour ----
# Minutes a patient has to finish paying before the reserved token is released.
RESERVATION_MINUTES=10
# Average consultation length used for the estimated-time calculation.
AVG_CONSULT_MIN=6
# Share of each department's daily tokens that can be booked online (rest = hospital counter).
ONLINE_SHARE=0.7
# Create the default 15 departments on first start when the database is empty.
AUTO_SEED=true
